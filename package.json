{
  "name": "reinss-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @reinss/desktop dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "cli": "node apps/cli/dist/main.js",
    "lint": "biome check .",
    "reinss": "node apps/cli/dist/main.js",
    "reinss:npx": "npx --yes --package ./apps/cli reinss",
    "bump": "pnpm -r --filter '!@reinss/desktop' --filter '!@reinss/ui' exec npm version patch --no-git-tag-version",
    "publish:all": "pnpm -r publish --access public",
    "release": "pnpm run bump && pnpm run publish:all",
    "release:dry": "pnpm -r publish --access public --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "bin": {
    "reinss": "./bin/reinss"
  }
}
