{
  "name": "@reins/node",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^8.1.2",
    "@babel/traverse": "^8.1.2",
    "@babel/types": "^8.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@reins/core": "workspace:*",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "zod": "^4.6.7"
  },
  "description": "Node adapters, Trail and Git integration, surface scanners, semantic diff, and knowledge loader for Reins.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
